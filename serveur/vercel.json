{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/peindre/:couleur",
      "destination": "/api/peindre?c=:couleur"
    },
    {
      "source": "/mur.svg",
      "destination": "/api/mur"
    },
    {
      "source": "/terminal.svg",
      "destination": "/api/terminal"
    },
    {
      "source": "/vues.svg",
      "destination": "/api/vues"
    },
    {
      "source": "/theme/:t",
      "destination": "/api/theme?t=:t"
    },
    {
      "source": "/img/:n",
      "destination": "/api/img?n=:n"
    },
    {
      "source": "/reagir/:r",
      "destination": "/api/reagir?r=:r"
    },
    {
      "source": "/reactions.svg",
      "destination": "/api/reactions"
    },
    {
      "source": "/live.svg",
      "destination": "/api/live"
    },
    {
      "source": "/theme-actuel.svg",
      "destination": "/api/themeactuel"
    }
  ],
  "headers": [
    {
      "source": "/themes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}